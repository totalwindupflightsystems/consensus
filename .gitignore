# Axiom (managed)
.worktrees/*/
.axiom/sessions/
.axiom/state/
# .axiom/* + negation keeps the committed co-author config (C-GAP-017);
# everything else under .axiom/ stays local.
.axiom/*
!.axiom/axiom.config.yaml
# .opencode/* + nested negation keeps the committed git-rules prompt
# (C-GAP-017); sibling local prompts stay ignored.
.opencode/*
!.opencode/prompts/
.opencode/prompts/*
!.opencode/prompts/git-rules.md
.hermes/
# The ROOT memory-bank skeleton (_index.md, _prompt.md, findings/) is
# committed (C-GAP-017); work-items/ and any other .memory-bank dirs
# (test artifacts, e.g. internal/chronicle/.memory-bank/) stay local.
**/.memory-bank/
!/.memory-bank/
!/.memory-bank/*
/.memory-bank/work-items/
_tmp/
.graph-harness/
.morty/

# GitReins — verdicts and history (contains evaluator output, not source)
.gitreins/history/
# GitReins — local task state (AGENTS.md: never commit tasks.yaml)
.gitreins/tasks.yaml
# GitReins — review-tool state (written by `gitreins review`, local-only; not source)
.gitreins/review-state.json
.gitreins/review-state.lock
.env

# Build artifacts
/consensus
/bin/
dev.db
*.db-shm
*.db-wal

# Work item — ephemeral test run output
**/runs/
dev.db*
.worktrees/

# Hilo — generated per-checkout graph state (rebuildable, never tracked).
# Every entry here is rewritten by `hilo graph warm` / `hilo graph search` from
# the tracked source tree plus the tracked .vfs/manifest.yaml, so tracking any
# of them dirties an ordinary checkout and fails scripts/release.sh preflight 1
# (RELEASE-CONSENSUS-008). Note .last_reconcile carries a wall-clock nanosecond
# stamp, so a regenerated value can never equal a committed one — that churn can
# never self-heal. Narrow paths only: .vfs/manifest.yaml stays tracked (authored
# config; `hilo init` never overwrites an existing manifest).
.vfs/graph/graph.db
.vfs/graph/graph.db.wal
.vfs/graph/.last_warm
.vfs/graph/.last_reconcile
.vfs/graph/.parse_cache.json
.vfs/graph/.symbols_cache.json
.vfs/graph/coverage.json
.vfs/graph/edges.jsonl
.vfs/graph/edges.jsonl.lock
.vfs/graph/state.json

# Test artifacts
coverage.out

# Credentials — NEVER commit these
.env
.auth.json
*_credentials.json
*_secrets.yaml
service-account*.json
*.pem
!*.pub.pem

# Hilo board — rebuildable local cache (Bane directive 08-07: JSONL canonical, db/parquet untracked)
.coding-hermes/board/board.db
.coding-hermes/board/board.db.wal
.coding-hermes/board/*.parquet

.coding-hermes/board/*.duckdb

# gitreins judge token telemetry (local-only)
.gitreins/usage.jsonl
dagger.db
.gitreins/logs/

# gitreins rescue archives (generated by gitreins rescue, not read again)
.gitreins/rescued-*/

# Local foreman manifests, serve logs, and worktree debris
.coding-hermes/waves/
serve-env.log
wt/

# Python bytecode (scripts/) 
__pycache__/
*.pyc
