# Axiom (managed)
.worktrees/*/
.axiom/sessions/
.axiom/state/
# .axiom/* + negation keeps the committed co-author config (C-GAP-017);
# everything else under .axiom/ stays local.
.axiom/*
!.axiom/axiom.config.yaml
# .opencode/* + nested negation keeps the committed git-rules prompt
# (C-GAP-017); sibling local prompts stay ignored.
.opencode/*
!.opencode/prompts/
.opencode/prompts/*
!.opencode/prompts/git-rules.md
.hermes/
# The ROOT memory-bank skeleton (_index.md, _prompt.md, findings/) is
# committed (C-GAP-017); work-items/ and any other .memory-bank dirs
# (test artifacts, e.g. internal/chronicle/.memory-bank/) stay local.
**/.memory-bank/
!/.memory-bank/
!/.memory-bank/*
/.memory-bank/work-items/
_tmp/
.graph-harness/
.morty/

# GitReins — verdicts and history (contains evaluator output, not source)
.gitreins/history/
.env

# Build artifacts
/consensus
/bin/
dev.db
*.db-shm
*.db-wal

# Work item — ephemeral test run output
**/runs/
dev.db*
.worktrees/

# Hilo — local cache files (rebuildable)
.vfs/graph/graph.db
.vfs/graph/graph.db.wal
.vfs/graph/.last_warm

# Test artifacts
coverage.out

# Credentials — NEVER commit these
.env
.auth.json
*_credentials.json
*_secrets.yaml
service-account*.json
*.pem
!*.pub.pem

# Hilo board — rebuildable local cache (Bane directive 08-07: JSONL canonical, db/parquet untracked)
.coding-hermes/board/board.db
.coding-hermes/board/board.db.wal
.coding-hermes/board/*.parquet

.coding-hermes/board/*.duckdb
