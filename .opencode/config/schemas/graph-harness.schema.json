{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "graph-harness.schema.json",
  "title": "Graph Harness Plugin Config",
  "description": "Configuration for the Axiom graph-harness OpenCode plugin. Load via loadPluginConfig('graph-harness', DEFAULT_CONFIG, repoRoot).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether the graph harness plugin is active. Set to false to disable without removing the plugin."
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "default": ".graph-harness/harness.db",
          "description": "Path to the SQLite database file, relative to repo root."
        }
      }
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "idle_evaluation_interval_ms": {
          "type": "integer",
          "default": 30000,
          "minimum": 1000,
          "description": "How often the harness evaluates pending nodes during session.idle events (ms)."
        },
        "heartbeat_timeout_seconds": {
          "type": "integer",
          "default": 300,
          "minimum": 30,
          "description": "Seconds without a heartbeat before a session is considered stale."
        },
        "condition_timeout_seconds": {
          "type": "integer",
          "default": 60,
          "minimum": 5,
          "description": "Max seconds to wait for a single condition evaluation."
        }
      }
    },
    "spawning": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_concurrent_sessions": {
          "type": "integer",
          "default": 5,
          "minimum": 1
        },
        "max_total_sessions": {
          "type": "integer",
          "default": 20,
          "minimum": 1
        },
        "max_spawn_depth": {
          "type": "integer",
          "default": 2,
          "minimum": 1,
          "maximum": 5
        },
        "spawn_method": {
          "type": "string",
          "enum": ["sdk", "cli"],
          "default": "sdk"
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_cost_per_graph_usd": { "type": "number", "default": 50.0, "minimum": 0 },
        "max_cost_per_node_usd": { "type": "number", "default": 10.0, "minimum": 0 },
        "warn_at_percent": { "type": "integer", "default": 80, "minimum": 1, "maximum": 100 }
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default_max_retries": { "type": "integer", "default": 3, "minimum": 0 },
        "backoff_base_seconds": { "type": "number", "default": 5, "minimum": 0 },
        "backoff_multiplier": { "type": "number", "default": 2, "minimum": 1 },
        "backoff_jitter": { "type": "boolean", "default": true },
        "flaky_bonus_attempts": { "type": "integer", "default": 2, "minimum": 0 },
        "max_total_retries_per_graph": { "type": "integer", "default": 50, "minimum": 0 }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_nodes_per_graph": { "type": "integer", "default": 100, "minimum": 1 },
        "max_nesting_depth": { "type": "integer", "default": 3, "minimum": 1 },
        "max_conditions_per_node": { "type": "integer", "default": 20, "minimum": 0 },
        "max_modifications_without_progress": { "type": "integer", "default": 10, "minimum": 1 },
        "max_node_active_minutes": { "type": "integer", "default": 30, "minimum": 1 },
        "max_graph_execution_hours": { "type": "integer", "default": 4, "minimum": 1 }
      }
    },
    "command_policy": {
      "type": "object",
      "additionalProperties": false,
      "description": "Controls which shell commands agents may execute via the harness.",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["permissive", "allowlist", "blocklist"],
          "default": "permissive",
          "description": "Enforcement mode: permissive (all allowed), allowlist (only listed), blocklist (listed denied)."
        },
        "allowlist": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Commands permitted when mode=allowlist."
        },
        "blocklist": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Commands denied when mode=blocklist."
        }
      }
    },
    "schedule_defaults": {
      "type": "object",
      "additionalProperties": false,
      "description": "Default limits for scheduled/repeating nodes.",
      "properties": {
        "max_repeat_count": {
          "type": "integer",
          "default": 100,
          "minimum": 1,
          "description": "Maximum number of times a repeat node may fire."
        },
        "schedule_lifetime_hours": {
          "type": "number",
          "default": 24,
          "minimum": 0,
          "description": "How many hours a scheduled trigger remains active before expiry."
        },
        "repeat_cost_cap_usd": {
          "type": "number",
          "default": 5.0,
          "minimum": 0,
          "description": "USD cost ceiling for a single repeating node across all its runs."
        }
      }
    },
    "templates": {
      "type": "object",
      "additionalProperties": false,
      "description": "Graph template discovery and loading settings.",
      "properties": {
        "directory": {
          "type": "string",
          "default": ".graph-harness/templates",
          "description": "Repo-relative path where user-defined graph template YAML files are stored."
        },
        "builtin": {
          "type": "boolean",
          "default": true,
          "description": "Whether built-in (shipped) templates are available."
        },
        "allow_global": {
          "type": "boolean",
          "default": false,
          "description": "Whether to search for templates outside the repo root (global install path)."
        }
      }
    },
    "api_policy": {
      "type": "object",
      "additionalProperties": false,
      "description": "Network egress policy for HTTP-check conditions and api-mode nodes.",
      "properties": {
        "blocked_ip_ranges": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "CIDR ranges that nodes may not contact (e.g. RFC-1918 ranges)."
        },
        "blocked_domains": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Hostnames or domain suffixes that nodes may not contact."
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "description": "Retention and archival settings for completed graphs.",
      "properties": {
        "archive_after_days": {
          "type": "integer",
          "default": 7,
          "minimum": 0,
          "description": "Days after completion before a graph is moved to the archive directory."
        },
        "archive_directory": {
          "type": "string",
          "default": ".graph-harness/archive",
          "description": "Repo-relative path where archived graph records are written."
        }
      }
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "notifications": { "type": "boolean", "default": true },
        "approval_required_for_dangerous": { "type": "boolean", "default": true }
      }
    }
  }
}
