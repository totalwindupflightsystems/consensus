    "llm_default_model": "deepseek-v4-flash",
    "llm_base_url": "http://127.0.0.1:18123/v1",
    "server_port": 18091,
    "max_open_conns": 5,
    "compression_enabled": false,
    "shape": "mirrors the shipped consensus.yaml; only server.port/pprof_addr, database.url and llm.base_url differ"
  },
  "databases": {
    "image": "pgvector/pgvector:pg16 (cached locally)",
    "armA": "consensus-pg-rc3 on host port 15439 — unmodified main, no DB modifications",
    "armB": "consensus-pg-rc3b on host port 15239 — one DB modification (agent_role BYPASSRLS)",
    "armM": "consensus-pg-rc3m on host port 15339 — two DB modifications (agent_role BYPASSRLS + GRANT USAGE,SELECT ON SEQUENCE memory_events_id_seq), each probe on its own fresh database (init before serve); config database.max_open_conns=5 (shipped default)",
    "armN": "consensus-pg-rc3n on host port 15449 — same two DB modifications, fresh database, config database.max_open_conns=10"
  },
  "commands": {
    "fresh_database": "docker run -d --rm --name <name> -e POSTGRES_USER=consensus -e POSTGRES_PASSWORD=rc3pass -e POSTGRES_DB=consensus -p <hostport>:5432 pgvector/pgvector:pg16",
    "init": "cd <repo worktree> && /tmp/consensus-rc3wt init --config /tmp/rc3/consensus-rc3<m>.yaml   # captures the admin key, applies all migrations",
    "serve": "cd <repo worktree> && /tmp/consensus-rc3wt serve --config /tmp/rc3/consensus-rc3<m>.yaml   # port 18091",
    "probe": "/tmp/loadprobe-rc3 --base-url http://127.0.0.1:18091 --admin-key \"$ADMIN_KEY\" --concurrency 1,4,16 --turns 20 --backend postgres --out <arm>.json",
    "armA_db_modifications": "none",
    "armB_db_modifications": "ALTER ROLE agent_role BYPASSRLS;",
    "armM_db_modifications": "ALTER ROLE agent_role BYPASSRLS; GRANT USAGE, SELECT ON SEQUENCE memory_events_id_seq TO agent_role;"
  },
