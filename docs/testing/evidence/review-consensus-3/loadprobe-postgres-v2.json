  },
  "llm_stub": {
    "source": "docs/testing/evidence/review-consensus-8/raw/mock-llm.py (copied verbatim to /tmp/rc3/mock-llm.py)",
    "launch": "R8_MOCK_PORT=18123 R8_REQLOG=/tmp/rc3/mock-llm-requests.jsonl python3 /tmp/rc3/mock-llm.py",
    "endpoint": "http://127.0.0.1:18123/v1 (OpenAI /v1/chat/completions; answers instantly, no provider egress, no credentials)",
    "what_this_measures": "the stub removes LLM latency from the loop, so every number below measures the Consensus DB + API write path (auth lookup, rate-limit accounting, memory_events INSERT, sessions UPDATE) — NOT model latency and NOT provider behaviour"
  },
